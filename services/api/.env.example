# development | test | production
APP_ENV=development
HTTP_ADDR=:8080
# debug | info | warn | error
LOG_LEVEL=info

# PostgreSQL connection. Matches docker-compose.yml.
DATABASE_URL=postgres://fogline:fogline@localhost:5432/fogline?sslmode=disable
# Apply pending migrations on startup. Defaults to true except in production.
DB_AUTO_MIGRATE=true

# HS256 signing key, at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ISSUER=fogline
# Access token lifetime. There is no refresh token yet, so this is the session length.
JWT_TTL=8h

# Send the session cookie over HTTPS only. Defaults to true in production.
COOKIE_SECURE=false
# Comma-separated origins allowed to call the API directly with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Allow public self-registration (always creates a TRAINEE).
ALLOW_REGISTRATION=true

# Optional: create this ADMIN at startup if the email is not registered yet.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Only for `go test`: a disposable database. Every table in it is dropped.
# TEST_DATABASE_URL=postgres://fogline:fogline@localhost:5432/fogline_test?sslmode=disable
